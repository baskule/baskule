{
  "name": "baskule-platform",
  "private": true,
  "type": "module",
  "description": "Baskule 0.2 celld app: Worker `baskule`, ControlCell, SpaceCell (T3 + embedded OpenCode)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integration": "bash test/integration.sh",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "fake-llm": "node dev/fake-llm/server.mjs",
    "dev": "../scripts/stack up"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@noble/hashes": "2.4.0",
    "@opencode/core": "2.1.3",
    "@opencode/schema": "2.1.3",
    "@opencode/sdk": "2.1.3",
    "@opencode/util": "2.1.3",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.1",
    "fflate": "0.8.2",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
