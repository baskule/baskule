{
  "name": "baskule-web",
  "main": "dist/web-worker/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "services": [{ "binding": "BACKEND", "service": "baskule" }],
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
