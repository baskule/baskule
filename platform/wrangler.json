{
  "name": "baskule",
  "main": "dist/runtime/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlCell" },
      { "name": "SPACE", "class_name": "SpaceCell" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlCell", "SpaceCell"] }],
  "vars": {
    "PUBLIC_ORIGINS": "",
    "SETUP_TOKEN": "",
    "AUTH_SECRET": "",
    "AUTH_RATE_LIMIT": "1",
    "COMPUTERD_URL": "http://127.0.0.1:47091",
    "COMPUTERD_TOKEN": "",
    "AUTH_CONFIG": "{}"
  }
}
