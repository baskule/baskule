# Optional: T3 Connect source builds with your own services.
# Copy this file to .env and fill the public identifiers for your own Clerk
# application and relay. Blank values leave this integration unconfigured.
# Do not add server-side secrets to this file.

# Get these public identifiers from your Clerk Dashboard under API keys,
# JWT templates, and OAuth applications.
T3CODE_CLERK_PUBLISHABLE_KEY=
T3CODE_CLERK_JWT_TEMPLATE=
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in T3CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# T3CODE_APPLE_TEAM_ID=
# T3CODE_MACOS_PROVISIONING_PROFILE=
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=

# Set the URL of your own relay; infra/relay contains its source.
T3CODE_RELAY_URL=

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# T3CODE_HOSTED_APP_URL=

# Optional: your own public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=
# T3CODE_MOBILE_OTLP_TRACES_DATASET=
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=
