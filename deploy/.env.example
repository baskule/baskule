# Baskule stack configuration (deploy). Copy to .env (gitignored, mode 600) and fill in.
# Generate secrets with: openssl rand -hex 32

# --- Edge (loopback by default; set your private interface address for remote access) ---
BASKULE_BIND=127.0.0.1
BASKULE_PORT=47090
PUBLIC_ORIGINS=http://127.0.0.1:47090

# --- Bucket (RustFS, internal only) ---
RUSTFS_ACCESS_KEY=baskule
RUSTFS_SECRET_KEY=
CELLD_BUCKET_NAME=baskule

# --- External bucket instead of RustFS (dedicated-host.md): setting S3_ENDPOINT adds docker-compose.s3.yml ---
#S3_ENDPOINT=https://s3.example.com
#S3_REGION=us-east-1
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# --- computerd / OpenShell ---
COMPUTERD_TOKEN=
OPENSHELL_VOLUMES_TOKEN=
COMPUTER_CPUS=2
COMPUTER_MEMORY=3Gi
# Caps of the baskule-openshell container (all computers together)
OPENSHELL_CPUS=3
OPENSHELL_MEMORY=8g

# --- Traces (baskule-traces: Jaeger, in memory; UI on BASKULE_BIND:BASKULE_TRACES_PORT) ---
#BASKULE_TRACES_PORT=47098
#BASKULE_TRACES_MAX=20000
#BASKULE_TRACES_MEMORY=1g
# Each producer exports to baskule-traces by default. Off: BASKULE_CELLD_OTEL=0 (celld), BASKULE_OTLP_TRACES_URL=
# (T3 in the cells), BASKULE_OPENSHELL_OTLP= (OpenShell gateway).

# Product settings (organization, AI provider/key/model, idle policy) are managed in Admin → Settings.
# Installation authentication is configured in auth.json. Reference provider secrets with {"env":"NAME"}.
AUTH_CONFIG_FILE=./auth.json
# For auth.google-workspace.example.json, set AUTH_CONFIG_FILE to that file and fill these values.
#AUTH_PUBLIC_ORIGIN=https://baskule.example.com
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# --- Platform (deployed as celld vars by the deploy job) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=
# First boot only: remove it from .env and re-run ./deploy.sh once the admin exists.
ADMIN_PASSWORD=
# Optional: empty = ControlCell generates and keeps one.
BETTER_AUTH_SECRET=
# auto = platform/ if built (platform/dist/worker.js), else the hello Worker; or: platform | hello
DEPLOY_APP=auto

# --- celld tuning ---
CELLD_V8_HEAP_LIMIT_MB=1024
CELLD_FETCH_TIMEOUT_S=3600
CELLD_CPUS=2
CELLD_MEMORY=3g
