# Baskule deployment config. Copy to deploy/.env (gitignored) and fill in.
# One file feeds BOTH the computer's OpenCode config (opencode.jsonc) and the server's T3 settings.json
# (defaultModelSelection / textGenerationModelSelection = opencode + "llm/<BASKULE_LLM_MODEL>").

# --- Model (OpenAI-compatible chat-completions endpoint) ------------------------------------------------
BASKULE_LLM_BASE_URL=https://api.openai.com/v1
BASKULE_LLM_API_KEY=
BASKULE_LLM_MODEL=gpt-6-luna
# JSON object of per-model settings (single-quoted so compose keeps the braces and quotes).
# gpt-6-luna needs reasoningEffort none: it rejects tools with reasoning on chat completions.
BASKULE_LLM_MODEL_SETTINGS='{"reasoningEffort":"none"}'
# Optional: USD per million tokens (OpenCode cost accounting) and token limits.
BASKULE_LLM_COST_INPUT=0.10
BASKULE_LLM_COST_OUTPUT=0.50
BASKULE_LLM_COST_CACHE_READ=0.01
BASKULE_LLM_COST_CACHE_WRITE=0.10
#BASKULE_LLM_CONTEXT_LIMIT=
#BASKULE_LLM_OUTPUT_LIMIT=

# Mistral example (untested):
#BASKULE_LLM_BASE_URL=https://api.mistral.ai/v1
#BASKULE_LLM_API_KEY=<mistral key>
#BASKULE_LLM_MODEL=mistral-medium-latest
#BASKULE_LLM_MODEL_SETTINGS='{}'
#BASKULE_LLM_COST_INPUT=0.4
#BASKULE_LLM_COST_OUTPUT=2

# --- Internal --------------------------------------------------------------------------------------------
# Basic-auth password between the server, computerd and OpenCode (user "opencode"). Never leaves baskule-net.
# Generate one: openssl rand -hex 24
BASKULE_OPENCODE_PASSWORD=change-me
# Minutes without requests (and no active OpenCode session) before the computer is stopped. Fractions allowed.
BASKULE_IDLE_MINUTES=10

# --- Network ---------------------------------------------------------------------------------------------
# Address the web UI is published on (port 47080). NO AUTH: use a private/Tailscale address only.
# For remote access, set BASKULE_BIND to your private interface address.
BASKULE_BIND=127.0.0.1
#BASKULE_PORT=47080

# --- Advanced --------------------------------------------------------------------------------------------
# Prefix of container/volume/network names (keep "baskule" for the real deployment).
#BASKULE_INSTANCE=baskule
# Image tag for baskule-server / baskule-computerd / baskule-computer.
#BASKULE_TAG=0.1
# Build context of the server image (the T3 fork). Default: ../app (the working tree).
#BASKULE_APP_CONTEXT=../app
