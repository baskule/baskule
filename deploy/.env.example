# Downloaded with docker-compose.yml. Keep .env private (chmod 600).
BASKULE_VERSION=0.5.0
BASKULE_REGISTRY=ghcr.io/baskule
BASKULE_BIND=127.0.0.1
BASKULE_PORT=47090
PUBLIC_ORIGINS=http://127.0.0.1:47090
ADMIN_NAME=Admin
ADMIN_EMAIL=
# First boot only. Clear it after sign-in, then rerun docker compose up -d.
ADMIN_PASSWORD=

# Generated by the image's init-env command.
RUSTFS_ACCESS_KEY=baskule
RUSTFS_SECRET_KEY=
COMPUTERD_TOKEN=
OPENSHELL_VOLUMES_TOKEN=
CELLD_BUCKET_NAME=baskule
# Local storage. For external S3, clear COMPOSE_PROFILES and set every S3 value below.
COMPOSE_PROFILES=storage
#S3_ENDPOINT=https://s3.example.com
#S3_REGION=us-east-1
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# Optional authentication JSON. Password sign-in needs no auth.json.
# Single quotes keep Compose from expanding dollar signs in this value.
#AUTH_CONFIG='{"version":1,"password":true,"publicOrigin":"https://baskule.example.com"}'
#BETTER_AUTH_SECRET=

# Resource limits, not reservations. Computers share the OpenShell cap.
CELLD_CPUS=2
CELLD_MEMORY=3g
CELLD_V8_HEAP_LIMIT_MB=1024
CELLD_FETCH_TIMEOUT_S=3600
COMPUTER_CPUS=2
COMPUTER_MEMORY=3Gi
OPENSHELL_CPUS=3
OPENSHELL_MEMORY=8g

# Optional in-memory traces: COMPOSE_PROFILES=storage,traces and enable these exporters.
#BASKULE_CELLD_OTEL=http://baskule-traces:4318
#BASKULE_OTLP_TRACES_URL=http://baskule-traces:4318/v1/traces
#BASKULE_OPENSHELL_OTLP=http://baskule-traces:4317
#BASKULE_TRACES_PORT=47098
