+#[cfg(test)]
+mod baskule_local_store_tests {
+    use super::*;
+
+    #[test]
+    fn local_store_metadata_ranges_match_binary_prefixes() {
+        let directory = tempfile::tempdir().unwrap();
+        let store = LocalStore::open(directory.path().join("objects.sqlite3")).unwrap();
+        let connection = store.connect().unwrap();
+        let keys = [
+            "cells/a",
+            "cells/a/item",
+            "cells/ab/item",
+            "literal%/item",
+            "é",
+            "é/item",
+            "ê",
+        ];
+        for key in keys {
+            connection
+                .execute(
+                    "INSERT INTO objects VALUES (?1, X'0001', 1, 0, '[]')",
+                    [key],
+                )
+                .unwrap();
+        }
+        for (prefix, expected) in [
+            ("", keys.as_slice()),
+            ("cells/a", &["cells/a", "cells/a/item", "cells/ab/item"]),
+            ("cells/a/", &["cells/a/item"]),
+            ("literal%/", &["literal%/item"]),
+            ("é", &["é", "é/item"]),
+            ("missing/", &[]),
+        ] {
+            let objects = store.metadata_sync(prefix).unwrap();
+            assert_eq!(
+                objects
+                    .iter()
+                    .map(|object| object.key.as_str())
+                    .collect::<Vec<_>>(),
+                expected
+            );
+            assert!(objects
+                .iter()
+                .all(|object| object.size == 2 && object.body.is_empty()));
+        }
+    }
+}
