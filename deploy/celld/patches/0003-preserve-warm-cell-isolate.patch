+/// An evaluation error is permanent in this realm, including a terminated TLA.
+pub(super) fn has_errored_module(scope: &mut v8::PinScope) -> bool {
+    let registry = modreg(scope);
+    let modules = registry.modules.lock().unwrap();
+    modules.values().any(|module| {
+        matches!(
+            v8::Local::new(scope, module).get_status(),
+            v8::ModuleStatus::Errored | v8::ModuleStatus::Evaluating
+        )
+    })
+}
