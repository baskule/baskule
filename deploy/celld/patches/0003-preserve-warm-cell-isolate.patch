+/// Return operations belonging to a different isolate's continuation registry.
+pub(crate) fn return_spawns(spawns: Vec<(u64, OpFuture, OpLifetime, Option<u64>)>) {
+    SPAWNS.with(|queue| {
+        queue.borrow_mut().extend(
+            spawns
+                .into_iter()
+                .map(|(id, future, lifetime, owner)| Spawn {
+                    id,
+                    future,
+                    lifetime,
+                    owner,
+                }),
+        );
+    });
