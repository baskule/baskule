+/// Ship caller-built sibling ES modules without evaluating or rebundling them.
+/// Only regular .js/.mjs files under the entry directory participate.
+fn collect_unbundled_es_modules(
+    directory: &Path,
+    relative: &str,
+    entry_path: &Path,
+    modules: &mut Vec<(String, Vec<u8>)>,
+) -> anyhow::Result<()> {
+    for entry in std::fs::read_dir(directory)
+        .with_context(|| format!("read ES module directory {}", directory.display()))?
+    {
+        let entry = entry?;
+        let file_type = entry.file_type()?;
+        let path = entry.path();
+        if path == entry_path {
+            continue;
+        }
+        let is_module = path
+            .extension()
+            .is_some_and(|extension| extension == "js" || extension == "mjs");
+        if !file_type.is_dir() && !is_module {
+            continue;
+        }
+        let name = entry
+            .file_name()
+            .into_string()
+            .map_err(|_| anyhow!("ES module path contains a non-UTF-8 name"))?;
+        if file_type.is_dir()
+            && matches!(
+                name.as_str(),
+                ".git" | ".celld" | ".wrangler" | "node_modules"
+            )
+        {
+            continue;
+        }
+        if name.contains(['\\', '\0']) {
+            bail!("invalid ES module path component: {name:?}");
+        }
+        let name = if relative.is_empty() {
+            name
+        } else {
+            format!("{relative}/{name}")
+        };
+        if file_type.is_dir() {
+            collect_unbundled_es_modules(&path, &name, entry_path, modules)?;
+        } else if file_type.is_file() {
+            modules.push((
+                name,
+                std::fs::read(&path)
+                    .with_context(|| format!("read ES module {}", path.display()))?,
+            ));
+        } else {
+            bail!("ES module {} is not a regular file", path.display());
+        }
+    }
+    Ok(())
+}
