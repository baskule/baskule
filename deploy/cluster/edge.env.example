BASKULE_BIND=127.0.0.1
BASKULE_PORT=47090
BASKULE_NODES_WORKER=10.0.0.11:47091 10.0.0.12:47091
# Optional load balancer addresses/CIDRs, separated by spaces. No forwarded headers are trusted by default.
#BASKULE_TRUSTED_PROXIES=10.0.0.5/32
# Use private_ranges for a host-local proxy only with loopback HTTP and access restricted to trusted sources.
# Replace X-Forwarded-For with the peer address (Caddy default); nginx: proxy_set_header X-Forwarded-For $remote_addr;
# With private_ranges, private-address LAN/VPN clients share the proxy's sign-in budget.
