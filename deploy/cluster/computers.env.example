# Node/computerd traffic is plain HTTP: the token controls every computer; exec/file streams flow both ways.
# Use a trusted private network or encrypted overlay (for example WireGuard).
# Firewall node port 47092 and S3 to platform nodes only, explicitly excluding the computers host.
BASKULE_VERSION=0.5.0
BASKULE_REGISTRY=ghcr.io/baskule
BASKULE_PRIVATE_IP=10.0.0.20
COMPUTERD_PORT=47094
# A reachable platform Worker or internal edge URL. Only idle policy is read here.
PLATFORM_URL=http://10.0.0.11:47091
COMPUTERD_TOKEN=
OPENSHELL_VOLUMES_TOKEN=
COMPUTER_CPUS=2
COMPUTER_MEMORY=3Gi
OPENSHELL_CPUS=3
OPENSHELL_MEMORY=8g
#BASKULE_OTLP_TRACES_URL=
#BASKULE_OPENSHELL_OTLP=
