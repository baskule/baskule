BASKULE_VERSION=0.5.0
BASKULE_REGISTRY=ghcr.io/baskule
BASKULE_PRIVATE_IP=10.0.0.11
CELLD_NODE=node-a
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
CELLD_BUCKET_NAME=baskule
# All nodes, including this one. Keep this list current before the next app deploy.
CELLD_NODES_INTERNAL=10.0.0.11:47092 10.0.0.12:47092
COMPUTERD_URL=http://10.0.0.20:47094
# Copy the computers host's token. Do not generate a separate token here.
COMPUTERD_TOKEN=
PUBLIC_ORIGINS=https://baskule.example.com
AUTH_CONFIG='{"version":1,"password":true,"publicOrigin":"https://baskule.example.com"}'
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional exporters: CELLD_OTEL accepts an OTLP HTTP base URL; 0 disables it.
#BASKULE_CELLD_OTEL=0
#BASKULE_OTLP_TRACES_URL=
