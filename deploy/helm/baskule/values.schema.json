{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicas": {"type": "integer", "minimum": 1},
    "publicUrl": {"type": "string", "pattern": "^https?://[^/?#@]+$"},
    "celld": {"type": "object", "properties": {"terminationGracePeriodSeconds": {"type": "integer", "minimum": 40}}},
    "exposure": {"type": "object", "properties": {"mode": {"enum": ["none", "ingress", "gateway"]}}}
  }
}
