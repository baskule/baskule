#!/usr/bin/env bash
# Shared host tools and per-worktree dependencies. Run from any directory in the checkout.
set -Eeuo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# New linked worktrees inherit the primary checkout's prepared host tools.
PRIMARY=$(dirname "$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)")
if [[ -L $ROOT/.tools ]]; then
  DEFAULT_SHARED=$(dirname "$(readlink -f "$ROOT/.tools")")
elif [[ -L $PRIMARY/.tools ]]; then
  DEFAULT_SHARED=$(dirname "$(readlink -f "$PRIMARY/.tools")")
else
  DEFAULT_SHARED=${XDG_CACHE_HOME:-$HOME/.cache}/baskule
fi
SHARED=${BASKULE_SHARED:-$DEFAULT_SHARED}
TOOLS=$SHARED/tools
PNPM_STORE=${BASKULE_PNPM_STORE:-$SHARED/cache/pnpm-store}
export npm_config_cache=${npm_config_cache:-$SHARED/cache/npm}
# Node and pnpm versions live in scripts/env.sh; each version gets its own directory so
# checkouts on an older pin keep working while the shared tools are upgraded.
eval "$(grep -E '^BASKULE_(NODE|PNPM)=' "$ROOT/scripts/env.sh")"
NODE=$BASKULE_NODE
NODE_VERSION=${NODE#node-}; NODE_VERSION=${NODE_VERSION%-linux-x64}
PNPM_VERSION=${BASKULE_PNPM#pnpm-}
START=$EPOCHREALTIME
STEP=arguments
TEMP=
trap 'status=$?; [ -z "$TEMP" ] || rm -rf "$TEMP"; if ((status)); then echo "worktree: $STEP failed (exit $status)" >&2; fi' EXIT
elapsed() { awk -v start="$1" -v end="$EPOCHREALTIME" 'BEGIN {printf "%.3fs", end-start}'; }
step() {
  STEP=$1
  shift
  local started=$EPOCHREALTIME
  echo "==> $STEP"
  "$@"
  echo "==> $STEP: $(elapsed "$started")"
}
help() {
  cat <<'HELP'
Usage: scripts/worktree <setup|runtime|host-init|--help>
  host-init  Install checksum-verified Node, celld 0.6.3 and pnpm (pins in env.sh);
             create shared caches. Safe to repeat or run concurrently.
  setup      Ensure host tools, link .tools and attach shared dependencies.
  runtime    Also build SpaceCell for local app/Worker/SpaceCell/agent checks.
             Opt in when needed; rerun after changing app/ before runtime checks.
Environment:
  BASKULE_SHARED      Shared root (existing .tools location, or user cache/baskule)
  BASKULE_PNPM_STORE  pnpm store (default $BASKULE_SHARED/cache/pnpm-store)
  npm_config_cache    npm cache (default $BASKULE_SHARED/cache/npm)
Requires Linux x86-64, bash, curl, tar, xz, sha256sum, flock, Python 3 and Git.
HELP
}
host_init() {
  [[ $(uname -s) = Linux && $(uname -m) = x86_64 ]] || { echo 'worktree: only Linux x86-64 is supported' >&2; return 1; }
  mkdir -p "$TOOLS/bin" "$PNPM_STORE" "$npm_config_cache"
  (
    flock 9
    if [[ ! -x $TOOLS/$NODE/bin/node ]]; then
      TEMP=$(mktemp -d "$TOOLS/.node-install.XXXXXX")
      trap 'rm -rf "$TEMP"' EXIT
      curl -fsSL --retry 3 "https://nodejs.org/dist/$NODE_VERSION/$NODE.tar.xz" -o "$TEMP/$NODE.tar.xz"
      curl -fsSL --retry 3 https://nodejs.org/dist/$NODE_VERSION/SHASUMS256.txt -o "$TEMP/SHASUMS256.txt"
      (cd "$TEMP"; awk -v file="$NODE.tar.xz" '$2 == file' SHASUMS256.txt > checksum; test -s checksum; sha256sum -c checksum)
      tar --no-same-owner -xJf "$TEMP/$NODE.tar.xz" -C "$TEMP"
      [[ $("$TEMP/$NODE/bin/node" --version) = "$NODE_VERSION" ]]
      mv "$TEMP/$NODE" "$TOOLS/$NODE"
      rm -rf "$TEMP"
      TEMP=
    fi
    export PATH="$TOOLS/$NODE/bin:$PATH"
    # Extract and validate the digest-pinned official celld image layer without Docker.
    local image=ghcr.io/denoland/celld:0.6.3@sha256:22bca1b40a9e4c434cc149d8913d7eaafa9792961a8c05f9fecf921d416216dc
    local layer=68df9b662f9fc236b0d3a77b66301b9f27fd1967642894dbff9ef284d1c0a564
    if [[ ! -x $TOOLS/bin/celld || $(cat "$TOOLS/bin/celld.source" 2>/dev/null) != "$image" ]]; then
      TEMP=$(mktemp -d "$TOOLS/.celld-install.XXXXXX")
      trap 'rm -rf "$TEMP"' EXIT
      local token
      token=$(curl -fsS --retry 3 'https://ghcr.io/token?scope=repository:denoland/celld:pull' | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])')
      curl -fsSL --retry 3 -H "Authorization: Bearer $token" -o "$TEMP/layer.tgz" "https://ghcr.io/v2/denoland/celld/blobs/sha256:$layer"
      echo "$layer  $TEMP/layer.tgz" | sha256sum -c --quiet
      tar -xzf "$TEMP/layer.tgz" -C "$TEMP" usr/local/bin/celld
      chmod 755 "$TEMP/usr/local/bin/celld"
      [[ $("$TEMP/usr/local/bin/celld" --version) = *0.6.3* ]]
      mv "$TEMP/usr/local/bin/celld" "$TOOLS/bin/celld"
      printf '%s\n' "$image" > "$TOOLS/bin/celld.source"
      rm -rf "$TEMP"
      TEMP=
    fi
    if [[ ! -x $TOOLS/$BASKULE_PNPM/node_modules/.bin/pnpm ]]; then
      npm install --prefix "$TOOLS/$BASKULE_PNPM" --prefer-offline --no-audit --no-fund "pnpm@$PNPM_VERSION"
    fi
  ) 9>"$TOOLS/.host-init.lock"
}
link_tools() {
  if [[ -e $ROOT/.tools && ! -L $ROOT/.tools ]]; then
    rm -rf "$ROOT/.tools"
  fi
  ln -sfnT "$TOOLS" "$ROOT/.tools"
}
install_app() {
  local hash marker=$ROOT/app/node_modules/.baskule-inputs
  # pnpm always revisits file: packages. Limit our skip key to install inputs,
  # including local archives and scripts that lifecycle hooks can call.
  hash=$( { python3 "$ROOT/scripts/source-hash.py" "$ROOT/app" \
    package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc '.pnpmfile.*' \
    ':(glob)**/package.json' ':(glob)**/.npmrc' ':(glob)**/scripts/**' \
    patches apps/mobile/deps
    sha256sum "$ROOT/scripts/worktree" "$ROOT/scripts/env.sh" "$ROOT/scripts/source-hash.py"
    printf '%s\n' "$PNPM_STORE"
  } | sha256sum | cut -d' ' -f1)
  if [[ -x $ROOT/app/node_modules/.bin/vp && $(cat "$marker" 2>/dev/null) = "$hash" ]]; then
    echo 'app: unchanged installation inputs; skipped'
    return
  fi
  rm -f "$marker"
  (cd "$ROOT/app"; pnpm install --frozen-lockfile --prefer-offline --config.confirmModulesPurge=false --reporter=append-only --store-dir "$PNPM_STORE")
  printf '%s\n' "$hash" > "$marker"
}
install_workspace() {
  (cd "$ROOT"; pnpm install --frozen-lockfile --prefer-offline --config.confirmModulesPurge=false --reporter=append-only --store-dir "$PNPM_STORE")
}
sync_bundle() {
  local hash marker=$ROOT/platform/src/space/t3/.worktree-inputs
  hash=$( { python3 "$ROOT/scripts/source-hash.py" "$ROOT/app"; sha256sum "$ROOT/platform/src/space/sync-bundle.sh"; } | sha256sum | cut -d' ' -f1)
  if [[ -s $ROOT/platform/src/space/t3/space-cell.js && -f $ROOT/platform/src/space/t3/BUILT_FROM && $(cat "$marker" 2>/dev/null) = "$hash" ]]; then
    echo 'SpaceCell: unchanged inputs; skipped'
    return
  fi
  rm -f "$marker"
  "$ROOT/platform/src/space/sync-bundle.sh"
  printf '%s\n' "$hash" > "$marker"
}
[[ $# = 1 ]] || { help >&2; exit 1; }
case $1 in
  --help|-h|help) help; exit 0 ;;
  host-init) step host-init host_init ;;
  setup|runtime)
    mkdir -p "$ROOT/.run"
    exec 8>"$ROOT/.run/worktree-setup.lock"
    flock 8
    step host-init host_init
    step tools link_tools
    source "$ROOT/scripts/env.sh"
    export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
    STEP=dependencies
    # pnpm imports and build hooks mutate the same global-store package files.
    # Serialize both workspaces and other worktrees through their shared store.
    (
      echo '==> waiting for shared dependency store'
      flock -w 600 9
      step workspace install_workspace
      step app install_app
    ) 9>"$PNPM_STORE/.worktree-install.lock"
    if [[ $1 = runtime ]]; then
      step SpaceCell sync_bundle
    else
      echo 'SpaceCell is optional. For local app/runtime checks, run: scripts/worktree runtime'
    fi
    ;;
  *) help >&2; exit 1 ;;
esac
echo "==> total: $(elapsed "$START")"
